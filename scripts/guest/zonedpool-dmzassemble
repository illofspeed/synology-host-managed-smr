#!/bin/bash
# zonedpool-dmzassemble - create the dm-zoned mappers (dz1..dzN) for the pool at boot.
# Install as /usr/local/sbin/zonedpool-dmzassemble (mode 0755); started by
# zonedpool-dmzassemble.service. See docs/03-guest-storage-stack.md.
#
# dm-zoned mappings are NOT persistent: nothing recreates them at boot, so without this the
# RAID cannot assemble and the pool stays unmounted. Devices are listed by /dev/disk/by-id
# path in /etc/zonedpool/dmzoned.conf, one per line as:  <by-id-path> <mapper-name>
# by-id, not /dev/sdX: kernel names move when a controller enumerates differently.
#
# Environment overrides:
#   ZP_DMZ_CONF  config file            (default /etc/zonedpool/dmzoned.conf)
#   ZP_DMZ_WAIT  seconds to wait for each device to appear (default 600)
set -u
CONF=${ZP_DMZ_CONF:-/etc/zonedpool/dmzoned.conf}
[ -r "$CONF" ] || { echo "no $CONF"; exit 0; }
rc=0
while read -r dev name; do
  case "$dev" in ''|\#*) continue;; esac
  [ -n "${name:-}" ] || continue
  # WAIT for the device. Host-managed drives behind a passed-through controller can take
  # minutes to enumerate; failing immediately here is why the first version of this unit left
  # the pool unassembled at boot. Bounded so a genuinely missing drive does not hang forever.
  waited=0
  while [ ! -b "$dev" ] && [ "$waited" -lt "${ZP_DMZ_WAIT:-600}" ]; do
    sleep 5; waited=$((waited+5))
  done
  if [ ! -b "$dev" ]; then
    logger -t zonedpool "dmzassemble: $dev still absent after ${waited}s - skipping"
    rc=1; continue
  fi
  [ "$waited" -gt 0 ] && logger -t zonedpool "dmzassemble: $dev appeared after ${waited}s"
  # Already assembled (e.g. unit restarted): nothing to do.
  if dmsetup info "$name" >/dev/null 2>&1; then continue; fi
  sz=$(blockdev --getsz "$dev") || { rc=1; continue; }
  # The dm-zoned target reads its metadata (written by `dmzadm --format`) from the drive.
  if dmsetup create "$name" --table "0 $sz zoned $dev"; then
    logger -t zonedpool "dmzassemble: $name from $dev"
  else
    logger -t zonedpool "dmzassemble: FAILED $name from $dev"; rc=1
  fi
done < "$CONF"
exit "$rc"
