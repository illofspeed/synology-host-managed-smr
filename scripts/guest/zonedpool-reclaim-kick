#!/bin/sh
# zonedpool-reclaim-kick — historical workaround for stalled idle polling on stock 7.2.x.
# Prefer the corrected patches/dm-zoned-reclaim.patch; its idle poll needs no timer.
# WARNING: on a stock module, a reclaim message can start the idle TEST UNIT READY
# CPU loop when random/cache zones are empty, or after a legitimate drain finishes.
# libata answers those SCSI requests in software for SATA disks; this is kernel CPU cost.
# A used-zone guard would not prevent the post-drain loop. This unconditional historical
# helper is retained for provenance, not recommended for stock-module installation.
# Build AND activate the corrected module, verify it, then disable the old timer.
# Upstream status: see patches/upstream/README.md; v4 was applied then reverted.
set -u
dmsetup ls --target zoned 2>/dev/null | awk '$2 ~ /^\(/ {print $1}' | while read -r t; do
  dmsetup message "$t" 0 reclaim 2>/dev/null ||
    logger -t zonedpool-reclaim-kick "reclaim message failed for $t"
done
exit 0
