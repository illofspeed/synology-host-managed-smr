# /etc/zonedpool/dmzoned.conf - read by /usr/local/sbin/zonedpool-dmzassemble at boot.
#
# <device by-id path>                               <mapper name>
#
# by-id, never /dev/sdX: kernel names move when the controller enumerates differently.
# Use the whole-disk link (no "-part" suffix). List yours with:
#   ls -l /dev/disk/by-id/ | grep WSH722870 | grep -v -- -part
# The mapper names must match what zonedpool-mdassemble.service expects (dz1, dz2, dz3).
/dev/disk/by-id/ata-WDC_WSH722870ALE604_<SERIAL_1>  dz1
/dev/disk/by-id/ata-WDC_WSH722870ALE604_<SERIAL_2>  dz2
/dev/disk/by-id/ata-WDC_WSH722870ALE604_<SERIAL_3>  dz3
